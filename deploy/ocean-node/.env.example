# Copy to .env on the server (not in the repository) and `chmod 600 .env`.
# scripts/deploy.zsh generates TYPESENSE_API_KEY and GRAPH_POSTGRES_PASSWORD on
# the server if they are missing; the other values you provide.

# --- Secrets -----------------------------------------------------------------
# Ocean Node identity / provider key: 0x + 64 hex characters.
# When moving an existing node, reuse its key (see docs/self-hosting.md).
PRIVATE_KEY=

# Internal only (never leave the Docker network). Generated if empty.
TYPESENSE_API_KEY=
GRAPH_POSTGRES_PASSWORD=

# Connector token of the Cloudflare Tunnel that publishes the node and the
# subgraph. Only needed with `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: an archive-capable Sepolia RPC with an API key for graph-node.
# Leave empty to use Tenderly's public gateway.
SEPOLIA_SUBGRAPH_RPC=

# Chatbot for /usecases/chatbot (profile chatbot). CHATBOT_API_KEY is written
# by scripts/setup-chatbot.zsh. To answer with Claude instead of the local
# model, set CHATBOT_BACKEND=anthropic and ANTHROPIC_API_KEY (1Password item
# "Clio-X chatbot Anthropic API key", field credential). Billed per question.
CHATBOT_API_KEY=
CHATBOT_BACKEND=ollama
CHATBOT_MODEL=
ANTHROPIC_API_KEY=
# Optional limits on questions (count only answers the model writes). They
# work only when the portal's Vercel project has CHATBOT_REQUIRE_SIGNIN=true,
# so the portal can say which wallet asked. Empty = no limit.
#   ALLOWED_USERS: JSON array or comma list; e.g. the same list as
#   C2D_ALLOWED_ADDRESSES to let only trial wallets ask.
#   DAILY_LIMIT_TOTAL is the real cost ceiling: new wallets are free to make.
CHATBOT_ALLOWED_USERS=
CHATBOT_DAILY_LIMIT_PER_USER=20
CHATBOT_DAILY_LIMIT_TOTAL=300

# --- Not secret --------------------------------------------------------------
# Wallets allowed to run free compute jobs, as a JSON array. Required: an
# empty list would let any Sepolia wallet run containers on this VM.
C2D_ALLOWED_ADDRESSES=["0xYourWalletAddress"]
