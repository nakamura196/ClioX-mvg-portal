+// Local change: skip events of dispensers created before startBlock.
+//
+// The Dispenser contract is one singleton for all datatokens, so with a
+// truncated startBlock we still receive TokensDispensed / Activated / ... for
+// dispensers whose DispenserCreated event we never saw. getDispenser() then
+// creates an empty entity, and saving it fails on the non-nullable `contract`
+// field. graph-node treats that as a non-deterministic error and retries the
+// same block forever, so the whole subgraph stops (Sepolia block 11701495).
+function isUnknownDispenser(dispenserID: string): boolean {
+  return Dispenser.load(dispenserID) === null
+}
