+// Local change: keep templateId correct when startBlock is truncated.
+//
+// Erc721Template / Erc20Template entities are only created by the
+// Template721Added / Template20Added events emitted right after the Ocean
+// contracts were deployed. If startBlock is moved close to our own publishes,
+// load() returns null and templateId is stored as 0. The portal branches on
+// this value (order() returns undefined unless templateId is 1 or 2), so
+// neither buying nor compute can start.
+//
+// Template contracts expose getId(), which can be read at any time, so fall
+// back to asking the chain when the registration event was missed.
 export function getErc721TemplateId(address: Address): BigInt {
   const template = Erc721Template.load(address.toHexString())
   if (template) {
     return template.templateId
   }
+  const onChain = ERC721TemplateContract.bind(address).try_getId()
+  if (!onChain.reverted) {
+    return BigInt.fromI32(onChain.value)
+  }
   return BigInt.zero()
 }
 
